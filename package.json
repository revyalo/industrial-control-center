{
  "name": "industrial-control-center",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "build:pages": "ng build --base-href /industrial-control-center/",
    "preview:pages": "node scripts/serve-static.mjs",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "npm run format:check && npm run typecheck && node --check scripts/serve-static.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "An interactive industrial monitoring dashboard built entirely in the browser with Angular 22.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/revyalo/industrial-control-center.git"
  },
  "homepage": "https://revyalo.github.io/industrial-control-center/",
  "bugs": {
    "url": "https://github.com/revyalo/industrial-control-center/issues"
  }
}
